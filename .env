# Dónde está tu MLflow Tracking Server
#MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Identificador del artefacto del modelo (elige UNA forma)
# Por versión exacta en el Registry:
#MODEL_URI=models:/<nombre_modelo>/<version>
MODEL_URI=models:/RandomForestRegressor2/1
# O por stage (si usas Staging/Production):
# MODEL_URI=models:/<nombre_modelo>/Production
